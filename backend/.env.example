# Used when running the backend natively (uvicorn) from inside backend/.
# When running via `docker compose up`, the root .env.example is used instead.
#
# DATABASE_URL works identically whether PostgreSQL is installed natively (Windows/macOS/Linux)
# or run via `docker compose up -d` — only the host/port/credentials differ. See README.md
# "Database Setup" for both paths. Never commit a real password here; this file is a template.
# The password below is a placeholder, not a default — use whatever password you set for the
# `postgres` role during your PostgreSQL install (the Windows installer often defaults it to
# `postgres`; Docker's default is whatever POSTGRES_PASSWORD you set in docker-compose.yml).
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/ventureforge_ai
APP_ENV=development
LOG_LEVEL=INFO
MODEL_DIR=../ml/models

# Optional: only set this if you want Gemini to add supplementary narrative commentary to the
# Judge Agent's output (executive summary, strategic observations). Leave unset/blank and the
# app works identically — the deterministic Judge Agent is the only thing that ever determines
# industry, confidence, funding score, or explanations. Never sent to the frontend.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
