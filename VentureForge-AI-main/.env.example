# VentureForge AI — root environment variables (used by docker-compose.yml and the backend).
#
# DATABASE_URL applies equally to a natively-installed PostgreSQL (Windows/macOS/Linux — no
# Docker required) or one started via `docker compose up -d`; only host/port/credentials change.
# See README.md "Database Setup". Never commit a real password — this file is a template only.

POSTGRES_DB=ventureforge
POSTGRES_USER=ventureforge
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/ventureforge_ai

APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173
MODEL_DIR=../ml/models
